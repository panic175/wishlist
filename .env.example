# Admin Credentials (REQUIRED)
# Set a strong username and password for the admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# JWT Secret (Optional - auto-generated if not provided)
# For production, generate a secure random string:
# openssl rand -base64 32
SECRET=

# Application Settings (Optional)
NODE_ENV=production
PORT=3000

# Cookie Security (Optional)
# Set to 'false' if accessing over HTTP (e.g., local LAN without HTTPS)
# When unset, auto-detects HTTPS via X-Forwarded-Proto header
# COOKIE_SECURE=false

# Timezone for logs (Optional)
TZ=America/New_York

# Default currency for wishlist items (Optional)
DEFAULT_CURRENCY=USD

# Forward-auth SSO (Optional) - works with any identity provider that can
# forward-authenticate at the reverse proxy (Authelia, Keycloak, Authentik,
# Ory, ...). When enabled, the reverse proxy must run /admin/* through the
# provider and inject the authenticated username into FORWARD_AUTH_USER_HEADER
# (it must match the header the proxy's forward-auth middleware injects).
# The app's own admin login is then disabled; only the admin area is protected.
# FORWARD_AUTH_ENABLED=true
# FORWARD_AUTH_USER_HEADER=Remote-User

# Identity provider portal URL (Optional - shown on the admin login page)
# FORWARD_AUTH_PORTAL_URL=https://auth.example.com

# Provider display name (Optional - used in the "Continue with {provider}"
# button). Defaults to "SSO".
# FORWARD_AUTH_PROVIDER_NAME=Keycloak

# Public hostname used by the Traefik router rules in docker-compose.yml (Optional)
# Only relevant for the docker-compose deployment, not for the app itself.
# WISHLIST_DOMAIN=wishlist.example.com
